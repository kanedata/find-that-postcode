{% set title = 'Forgot Password' %}
{% extends "base.html.j2" %}

{% block content %}
<section class="section entry-content" id="forgot-password">
  <div class="container">
    <div class="columns">
      <div class="column is-6 is-offset-3">
        <div class="box">
          <h1 class="title is-3 has-text-centered">Forgot Password</h1>
          
          {% if message %}
          <div class="notification is-info">
            {{ message }}
          </div>
          {% endif %}
          
          {% if error %}
          <div class="notification is-danger">
            {{ error }}
          </div>
          {% endif %}
          
          <form id="forgot-password-form">
            <div class="field">
              <label class="label">Email</label>
              <div class="control">
                <input class="input" type="email" id="email" placeholder="Your email" required>
              </div>
            </div>
            
            <div class="field">
              <div class="control">
                <button type="submit" class="button is-primary is-fullwidth">Reset Password</button>
              </div>
            </div>
            
            <div class="has-text-centered">
              <p>Remember your password? <a href="/login">Login here</a></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block bodyscripts %}
{{ super() }}
<script>
document.getElementById('forgot-password-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  
  const email = document.getElementById('email').value;
  
  try {
    const response = await fetch('/api/v2/auth/forgot-password', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        email: email
      })
    });
    
    if (response.ok) {
      const data = await response.json();
      
      // Show success message
      const successDiv = document.createElement('div');
      successDiv.className = 'notification is-success';
      successDiv.textContent = data.message;
      
      const form = document.getElementById('forgot-password-form');
      form.innerHTML = '';
      form.appendChild(successDiv);
    } else {
      const error = await response.json();
      
      // Show error message
      const errorDiv = document.createElement('div');
      errorDiv.className = 'notification is-danger';
      errorDiv.textContent = error.detail || 'Failed to send reset email';
      
      const form = document.getElementById('forgot-password-form');
      form.insertBefore(errorDiv, form.firstChild);
    }
  } catch (error) {
    console.error('Forgot password error:', error);
    
    const errorDiv = document.createElement('div');
    errorDiv.className = 'notification is-danger';
    errorDiv.textContent = 'An error occurred while processing your request';
    
    const form = document.getElementById('forgot-password-form');
    form.insertBefore(errorDiv, form.firstChild);
  }
});
</script>
{% endblock %}